---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css'
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="bg-[#0a1520] text-gray-100 min-h-screen overflow-x-hidden">
		<div class="relative min-h-screen w-full bg-[#0a1520] bg-[radial-gradient(circle,rgba(0,200,255,0.1)_2px,transparent_2px),linear-gradient(rgba(0,200,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(0,200,255,0.05)_1px,transparent_1px)] bg-[50px_50px,25px_25px,25px_25px] before:absolute before:inset-0 before:bg-gradient-to-br before:from-[rgba(10,21,32,0.9)] before:to-[rgba(10,21,32,0.7)] before:z-[-1]">
			<slot />
		</div>
		<footer class="py-6 text-center text-gray-400 text-sm">
			<p>© 2025 Proyecto Apple One - Creado por Tu Nombre</p>
		</footer>
	</body>
</html>
