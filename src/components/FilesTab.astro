---
// Importación de iconos de react-icons
import {
  FaRegFilePdf,
  FaRegFileWord,
  FaRegFilePowerpoint,
  FaDownload,
} from "react-icons/fa6";
import { AiOutlineInfoCircle } from "react-icons/ai";

// Definición de los archivos disponibles
const files = [
  {
    name: "Información en PDF",
    icon: FaRegFilePdf,
    color: "text-red-500",
    bg: "bg-red-500/10",
    filename: "informacion-apple-one.pdf",
    size: "2.4 MB",
  },
  {
    name: "Documento Word",
    icon: FaRegFileWord,
    color: "text-blue-500",
    bg: "bg-blue-500/10",
    filename: "documento-word.docx",
    size: "1.8 MB",
  },
  {
    name: "Presentación PowerPoint",
    icon: FaRegFilePowerpoint,
    color: "text-orange-500",
    bg: "bg-orange-500/10",
    filename: "presentacion-apple-one.pptx",
    size: "5.2 MB",
  },
];
---

<div
  id="files-tab"
  class="p-8 rounded-lg shadow-lg animate-fade-in bg-transparent"
>
  <h2 class="text-3xl font-bold mb-6 text-center text-cyan-50">
    Archivos Disponibles
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
    {
      files.map((file) => (
        <div class="bg-gray-800 p-6 rounded-xl border border-cyan-400/20 hover:border-cyan-400/40 transition-all duration-300 hover:scale-[1.02] group">
          <div class="flex flex-col items-center text-center h-full">
            <div
              class={`w-16 h-16 rounded-lg ${file.bg} flex items-center justify-center mb-4 group-hover:scale-110 transition-transform`}
            >
              <file.icon className={`text-2xl ${file.color}`} />
            </div>
            <h3 class="text-xl font-semibold mb-2 text-white">{file.name}</h3>
            <p class="text-gray-400 text-sm mb-4">{file.size}</p>
            <button
              class="download-btn mt-auto flex items-center px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg transition-colors duration-300 w-full justify-center"
              data-filename={file.filename}
              aria-label={`Descargar ${file.name}`}
            >
              <FaDownload className="mr-2" />
              Descargar
            </button>
          </div>
        </div>
      ))
    }
  </div>

  <div
    class="mt-10 p-6 bg-gray-900/70 rounded-lg border border-cyan-400/20 hover:border-cyan-400/40 transition-colors duration-300"
  >
    <div class="flex items-start">
      <div class="mr-4 mt-1 flex-shrink-0">
        <AiOutlineInfoCircle className="h-6 w-6 text-yellow-400" />
      </div>
      <div>
        <p class="text-gray-300 mb-2">
          Estos archivos contienen información detallada sobre los planes de
          Apple One, comparativas de precios y guías de uso.
        </p>
        <p class="text-gray-400 text-sm">
          Tip: Los archivos se descargarán directamente a tu dispositivo.
          Verifica que tienes espacio suficiente.
        </p>
      </div>
    </div>
  </div>
</div>

<style is:global>
  #files-tab button:active {
    transform: scale(0.98);
  }
</style>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    // Manejar descargas
    const downloadButtons = document.querySelectorAll(".download-btn");

    downloadButtons.forEach((button) => {
      button.addEventListener("click", (e) => {
        const filename = e.currentTarget.getAttribute("data-filename");
        const link = document.createElement("a");
        link.href = `/archivos/${filename}`;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        // Opcional: Añadir animación de feedback
        e.currentTarget.classList.add("scale-95");
        setTimeout(() => {
          e.currentTarget.classList.remove("scale-95");
        }, 200);
      });
    });
  });
</script>
