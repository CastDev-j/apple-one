---
---

<div class="fixed top-0 left-0 w-full h-full -z-10 overflow-hidden">
  <div class="absolute bg-cyan-500/10 h-px w-full top-[30%] animate-[pulse_4s_infinite,moveHorizontal_30s_linear_infinite]"></div>
  <div class="absolute bg-cyan-500/10 w-px h-full left-[40%] animate-[pulse_4s_infinite,moveVertical_30s_linear_infinite]"></div>
  <div class="absolute w-1 h-1 rounded-full bg-cyan-500/60 shadow-[0_0_10px_rgba(0,200,255,0.8)] animate-pulse top-[20%] left-[30%]"></div>
  <div class="absolute w-1 h-1 rounded-full bg-cyan-500/60 shadow-[0_0_10px_rgba(0,200,255,0.8)] animate-pulse top-[70%] left-[60%] animate-delay-[500ms]"></div>
  <div class="absolute w-1 h-1 rounded-full bg-cyan-500/60 shadow-[0_0_10px_rgba(0,200,255,0.8)] animate-pulse top-[40%] left-[80%] animate-delay-[1.5s]"></div>
  <div class="absolute w-1 h-1 rounded-full bg-cyan-500/60 shadow-[0_0_10px_rgba(0,200,255,0.8)] animate-pulse top-[80%] left-[20%] animate-delay-[2s]"></div>
</div>

<style>
  @keyframes pulse {
    0%, 100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes moveHorizontal {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @keyframes moveVertical {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(100%);
    }
  }
</style>
